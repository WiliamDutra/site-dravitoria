# Variáveis de ambiente, site da Dra. Vitória Gomes.
# Copie para `.env` e preencha. NUNCA commitar o `.env` com valores reais.

# URL pública do site. Domínio registrado no Registro.br.
PUBLIC_SITE_URL="https://dravitoriagomes.com.br"

# WhatsApp de atendimento (formato internacional, só dígitos: 55 + DDD + número).
# Número real de atendimento: +55 85 99236-4924.
PUBLIC_WHATSAPP="5585992364924"

# Google Maps Embed API key, usada só nas páginas com vínculo local real
# (Ceará, Fortaleza, Serra de Baturité). Deixe vazio para não renderizar o mapa.
GOOGLE_MAPS_EMBED_KEY=""

# OpenAI, usada só localmente pelo script scripts/gen-images.mjs.
# Nunca vai para o build nem para o cliente. Preencher apenas no .env local.
OPENAI_API_KEY=""

# Reservado (não usado hoje, porque o agendamento é só WhatsApp).
# Ative quando/se quiser um formulário server-side (exige adapter SSR + resend).
CONTACT_EMAIL=""
RESEND_API_KEY=""
