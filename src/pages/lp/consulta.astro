---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import Section from '../../components/ui/Section.astro';
import WhatsAppCTA from '../../components/WhatsAppCTA.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import TrustBadge from '../../components/TrustBadge.astro';
import CFMDisclaimer from '../../components/CFMDisclaimer.astro';
import { faqGeral } from '../../data/faqGeral';

// Landing de tráfego (fase posterior). noindex, não entra no sitemap.
const lpMsg =
  'Olá, Dra. Vitória! Vim de um anúncio e gostaria de marcar uma consulta online. 🤍';
const lpFaqs = faqGeral.slice(0, 4);
---

<BaseLayout
  title="Cuidar de você não é luxo nem fraqueza"
  description="Psiquiatria funcional integrativa por telemedicina, para todo o Brasil. Um cuidado que olha você por inteiro."
  noindex={true}
>
  <Section band="dark" class="lp-hero">
    <span class="eyebrow">Consulta de psiquiatria online</span>
    <h1>Cuidar de você não é luxo nem fraqueza</h1>
    <p class="lp-hero__lead">
      É o começo de tudo. Psiquiatria funcional integrativa por telemedicina, um
      cuidado que olha você por inteiro: o sintoma, o sono, o corpo, a sua
      história e o seu sentido. De onde você estiver no Brasil.
    </p>
    <div class="lp-hero__actions">
      <WhatsAppCTA message={lpMsg} label="Quero me cuidar" variant="primary" />
    </div>
    <TrustBadge class="lp-hero__badge" />
  </Section>

  <Section band="light" tight>
    <div class="lp-benefits">
      <div class="lp-benefit">
        <span>🤍</span>
        <h3>Você é escutada por inteiro</h3>
        <p>A consulta começa pela sua história, com tempo de verdade, não pela receita.</p>
      </div>
      <div class="lp-benefit">
        <span>💻</span>
        <h3>Online, para todo o Brasil</h3>
        <p>Do conforto e do sigilo da sua casa, sem deslocamento e sem fila.</p>
      </div>
      <div class="lp-benefit">
        <span>🌱</span>
        <h3>Ciência com acolhimento</h3>
        <p>Medicação quando é preciso, estilo de vida e sentido, tudo somando, sem culpa.</p>
      </div>
    </div>
  </Section>

  <Section band="ivory" tight>
    <h2 style="text-align:center;">Sobre a consulta online</h2>
    <div class="lp-faq">
      <FAQAccordion items={lpFaqs} />
    </div>
  </Section>

  <Section band="mid">
    <div class="lp-cta">
      <p class="lp-cta__anchor">“Você não precisa atravessar isso sozinha.”</p>
      <h2>Quando você sentir que é a hora, estou aqui</h2>
      <WhatsAppCTA message={lpMsg} label="Agende sua consulta" variant="outline-light" />
      <CFMDisclaimer class="lp-disclaimer" />
    </div>
  </Section>
</BaseLayout>

<style>
  .lp-hero__lead {
    color: var(--color-sand);
    font-size: 1.15rem;
    max-width: 56ch;
    margin: 1rem 0 1.75rem;
  }
  .lp-hero__badge {
    margin-top: 2rem;
    color: var(--color-sand) !important;
  }
  .lp-benefits {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 768px) {
    .lp-benefits {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .lp-benefit span {
    font-size: 1.6rem;
  }
  .lp-benefit h3 {
    margin: 0.5rem 0 0.4rem;
  }
  .lp-benefit p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.92rem;
  }
  .lp-faq {
    max-width: 780px;
    margin-inline: auto;
  }
  .lp-cta {
    text-align: center;
    max-width: 620px;
    margin-inline: auto;
  }
  .lp-cta__anchor {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-size: clamp(1.5rem, 3vw, 2.1rem);
    color: var(--color-clay);
    margin-bottom: 0.75rem;
  }
  .lp-disclaimer {
    margin-top: 2.5rem;
    text-align: left;
  }
</style>
