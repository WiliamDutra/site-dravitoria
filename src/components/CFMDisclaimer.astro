---
import { site } from '../data/site';

interface Props {
  text?: string;
  class?: string;
}
const { text = site.disclaimers.conteudoEducativo, class: className = '' } =
  Astro.props;
---

<p class:list={['cfm-disclaimer', className]}>
  <span class="cfm-disclaimer__label">Aviso</span>
  {text}
</p>

<style>
  .cfm-disclaimer {
    font-size: 0.82rem;
    line-height: 1.6;
    color: var(--text-muted);
    border-top: 1px solid var(--color-line);
    padding-top: 1rem;
    margin-top: 2rem;
    max-width: 75ch;
  }
  .band-dark .cfm-disclaimer,
  .band-mid .cfm-disclaimer,
  .band-coffee .cfm-disclaimer {
    color: var(--color-sand);
    border-top-color: var(--color-line-dark);
  }
  .cfm-disclaimer__label {
    display: inline-block;
    font-family: 'Jost', sans-serif;
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-clay);
    margin-right: 0.5rem;
  }
</style>
