---
// Bloco 6 — ProcessSteps: restyle pra 3 cards Antes/Durante/Depois (Iteração
// 3, inspirado na referência Paola Ferrer/Claude Design). MESMO dado real de
// antes (src/data/conditions.ts, condição "psiquiatra-online",
// howCareWorks.steps — 5 passos), só reagrupado em 3 fases; nenhuma copy
// nova. CTA ao lado mantido como já estava.
import Section from '../../ui/Section.astro';
import WhatsAppCTA from '../../WhatsAppCTA.astro';
import { getCondition } from '../../../data/conditions';

interface Props {
  message?: string;
}
const { message } = Astro.props;

const psiquiatraOnline = getCondition('psiquiatra-online');
const steps = psiquiatraOnline?.howCareWorks.steps ?? [];

// Agrupamento: passo 1 = Antes; passos 2-3 = Durante; passos 4-5 = Depois.
const phases = [
  { label: 'Antes', items: steps.slice(0, 1) },
  { label: 'Durante', items: steps.slice(1, 3) },
  { label: 'Depois', items: steps.slice(3, 5) },
];
---

<Section band="light" class="dvlp-steps">
  <span class="eyebrow">Como funciona</span>
  <h2>{psiquiatraOnline?.howCareWorks.title ?? 'Como é a consulta'}</h2>

  <div class="dvlp-steps__grid">
    {
      phases.map((phase) => (
        <div class="dvlp-steps__card">
          <div class="dvlp-steps__card-header">
            <span class="dvlp-steps__card-monogram" aria-hidden="true">V</span>
            {phase.label}
          </div>
          <ul class="dvlp-steps__card-body">
            {phase.items.map((step) => (
              <li>{step.body}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  <div class="dvlp-steps__cta">
    <p class="dvlp-steps__cta-text">Pronta pra dar o primeiro passo?</p>
    <WhatsAppCTA message={message} label="Agendar minha consulta" variant="primary" class="dvlp-steps__cta-btn" />
  </div>
</Section>

<style>
  /* :global() necessário — .dvlp-steps é a classe raiz do <Section>
     (componente filho), o CSS escopado normal do Astro não alcançaria. */
  :global(.dvlp-steps) {
    font-family: 'DM Sans', sans-serif;
  }
  :global(.dvlp-steps) h2 {
    font-family: 'Outfit', sans-serif;
  }
  .dvlp-steps__grid {
    margin-top: 2rem;
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 768px) {
    .dvlp-steps__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .dvlp-steps__card {
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-cream);
    box-shadow: var(--shadow-card);
  }
  .dvlp-steps__card-header {
    position: relative;
    overflow: hidden;
    padding: 0.9rem 1.1rem;
    background: var(--color-espresso);
    color: var(--color-ivory);
    font-family: 'Outfit', sans-serif;
    font-size: 1.05rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .dvlp-steps__card-monogram {
    position: absolute;
    top: -0.55rem;
    right: 0.25rem;
    font-family: 'Outfit', sans-serif;
    font-style: italic;
    font-weight: 600;
    font-size: 3.5rem;
    line-height: 1;
    color: rgba(246, 238, 225, 0.14);
    pointer-events: none;
  }
  .dvlp-steps__card:nth-child(2) .dvlp-steps__card-header {
    background: var(--color-mocha);
  }
  .dvlp-steps__card:nth-child(3) .dvlp-steps__card-header {
    background: var(--color-coffee);
  }
  .dvlp-steps__card-body {
    list-style: none;
    margin: 0;
    padding: 1rem 1.1rem;
    display: grid;
    gap: 0.75rem;
  }
  .dvlp-steps__card-body li {
    position: relative;
    padding-left: 1.1rem;
    font-size: 0.86rem;
    line-height: 1.55;
    color: var(--color-coffee);
  }
  .dvlp-steps__card-body li::before {
    content: '›';
    position: absolute;
    left: 0;
    color: var(--color-clay);
    font-weight: 700;
  }
  .dvlp-steps__cta {
    margin-top: 1.75rem;
    text-align: center;
  }
  .dvlp-steps__cta-text {
    font-family: 'Outfit', sans-serif;
    font-weight: 300;
    font-size: 1.2rem;
    color: var(--color-mocha);
    margin: 0 0 1rem;
  }

  /* :global() necessário — .dvlp-steps__cta-btn é aplicado no <a> renderizado
     por WhatsAppCTA.astro (componente compartilhado); mesmo padrão verde
     WhatsApp já usado no Hero/ProblemSection/FinalCta. */
  :global(.dvlp-steps__cta-btn.wa-cta--primary) {
    background: #25d366;
    color: #0b3b23;
    box-shadow: 0 8px 24px -6px rgba(37, 211, 102, 0.55);
  }
  :global(.dvlp-steps__cta-btn.wa-cta--primary:hover) {
    background: #1fb857;
    color: #0b3b23;
  }
</style>
