---
// Frase-âncora da copy mestra: itálico Cormorant, destaque editorial.
interface Props {
  as?: string;
  class?: string;
}
const { as: Tag = 'p', class: className = '' } = Astro.props;
---

<Tag class:list={['anchor', className]}>
  <slot />
</Tag>

<style>
  .anchor {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-style: italic;
    font-weight: 500;
    font-size: clamp(1.4rem, 2.6vw, 2rem);
    line-height: 1.3;
    max-width: 26ch;
    text-wrap: balance;
  }
</style>
