---
import { site } from '../data/site';

interface Props {
  variant?: 'inline' | 'block';
  class?: string;
}
const { variant = 'inline', class: className = '' } = Astro.props;
---

<span class:list={['trust-badge', `trust-badge--${variant}`, className]}>
  <span class="trust-badge__mark" aria-hidden="true">✦</span>
  <span class="trust-badge__text">
    <strong>{site.nome}</strong>, {site.titulo} · {site.crm}{
      site.rqe ? ` · ${site.rqe}` : ''
    }
  </span>
</span>

<style>
  .trust-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'Jost', sans-serif;
    font-size: 0.8rem;
    letter-spacing: 0.02em;
    color: var(--color-muted);
  }
  .trust-badge__mark {
    color: var(--color-clay);
  }
  .trust-badge__text strong {
    color: inherit;
    font-weight: 500;
  }
  .trust-badge--block {
    padding: 0.6rem 0.9rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
    background: var(--surface);
  }
</style>
