---
import { whatsappLink, mensagemAgendamento } from '../data/site';

interface Props {
  message?: string;
  label?: string;
  variant?: 'primary' | 'outline' | 'outline-light';
  block?: boolean;
  class?: string;
}
const {
  message = mensagemAgendamento,
  label = 'Agende sua consulta',
  variant = 'primary',
  block = false,
  class: className = '',
} = Astro.props;

const href = whatsappLink(message);
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class:list={['wa-cta', `wa-cta--${variant}`, block && 'wa-cta--block', className]}
  data-cta="whatsapp"
>
  <svg class="wa-cta__icon" viewBox="0 0 24 24" aria-hidden="true" width="18" height="18">
    <path
      fill="currentColor"
      d="M12.04 2c-5.5 0-9.96 4.46-9.96 9.96 0 1.76.46 3.48 1.34 5L2 22l5.2-1.36a9.9 9.9 0 0 0 4.84 1.24h.01c5.5 0 9.96-4.46 9.96-9.96S17.54 2 12.04 2Zm5.8 14.24c-.24.68-1.4 1.3-1.94 1.34-.5.06-1.12.08-1.8-.12-.42-.12-.96-.3-1.66-.6-2.92-1.26-4.82-4.2-4.96-4.4-.14-.2-1.18-1.56-1.18-2.98s.74-2.12 1-2.4c.26-.28.58-.36.78-.36l.56.01c.18.01.42-.07.66.5.24.58.82 2 .9 2.14.08.14.12.3.02.5-.1.2-.14.3-.28.46-.14.16-.3.36-.42.48-.14.14-.28.28-.12.56.16.28.72 1.18 1.54 1.92 1.06.94 1.94 1.24 2.22 1.38.28.14.44.12.6-.08.16-.2.68-.8.86-1.08.18-.28.36-.24.6-.14.24.1 1.54.72 1.8.86.26.14.44.2.5.32.06.12.06.68-.18 1.36Z"
    ></path>
  </svg>
  <span class="wa-cta__label">{label}</span>
  <span class="wa-cta__arrow" aria-hidden="true">→</span>
</a>

<script>
  import '../scripts/whatsapp-ref';
</script>

<style>
  .wa-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: 'Jost', sans-serif;
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    line-height: 1;
    padding: 0.95rem 1.8rem;
    border-radius: var(--radius-pill);
    border: 1.5px solid transparent;
    transition:
      transform 0.18s ease,
      background-color 0.18s ease,
      color 0.18s ease;
  }
  .wa-cta--block {
    display: flex;
    width: 100%;
    justify-content: center;
  }
  .wa-cta__arrow {
    transition: transform 0.18s ease;
  }
  .wa-cta:hover .wa-cta__arrow {
    transform: translateX(3px);
  }
  .wa-cta--primary {
    background: var(--color-primary);
    color: var(--color-ivory);
  }
  .wa-cta--primary:hover {
    background: var(--color-primary-hover);
    color: var(--color-ivory);
    transform: translateY(-1px);
  }
  .wa-cta--outline {
    color: var(--color-primary);
    border-color: var(--color-primary);
  }
  .wa-cta--outline:hover {
    background: var(--color-primary);
    color: var(--color-ivory);
  }
  .wa-cta--outline-light {
    color: var(--color-ivory);
    border-color: var(--color-ivory);
  }
  .wa-cta--outline-light:hover {
    background: var(--color-ivory);
    color: var(--color-espresso);
  }
</style>
