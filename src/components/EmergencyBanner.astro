---
import { site } from '../data/site';

interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<aside class:list={['emergency', className]} role="note" aria-label="Canais de emergência em saúde mental">
  <div class="emergency__icon" aria-hidden="true">🤍</div>
  <div class="emergency__body">
    <p class="emergency__title">Se você está em sofrimento agora, procure ajuda imediata.</p>
    <p class="emergency__text">
      Se você pensa em se machucar ou está passando por uma crise, ligue para o
      <a href={`tel:${site.emergencia.cvv}`}><strong>CVV {site.emergencia.cvv}</strong></a>
      (atendimento 24h, gratuito e sigiloso) ou procure a emergência mais próxima pelo
      <a href={`tel:${site.emergencia.samu}`}><strong>SAMU {site.emergencia.samu}</strong></a>.
      Você não está sozinha, e pedir ajuda agora é o passo mais corajoso.
    </p>
  </div>
</aside>

<style>
  .emergency {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 1.25rem 1.4rem;
    background: color-mix(in srgb, var(--color-clay) 16%, var(--color-cream));
    border: 1px solid var(--color-clay);
    border-left: 4px solid var(--color-primary);
    border-radius: var(--radius-md);
    color: var(--color-espresso);
  }
  .emergency__icon {
    font-size: 1.4rem;
    line-height: 1.4;
  }
  .emergency__title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.2rem;
    font-weight: 600;
    margin: 0 0 0.35rem;
  }
  .emergency__text {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.6;
    max-width: none;
  }
  .emergency__text a {
    color: var(--color-primary);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
  }
</style>
