---
import { mainNav } from '../../data/nav';
import { site } from '../../data/site';

interface Props {
  transparent?: boolean;
}
const { transparent = false } = Astro.props;
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) =>
  href === '/' ? current === '/' : current.startsWith(href);
---

<header
  class:list={['site-header', transparent && 'site-header--transparent']}
  data-transparent={transparent ? 'true' : 'false'}
>
  <div class="container site-header__inner">
    <a href="/" class="brand" aria-label={`${site.nome}, página inicial`}>
      <span class="brand__name">{site.nome}</span>
      <span class="brand__meta">Saúde mental · {site.crm}</span>
    </a>

    <nav class="nav" aria-label="Navegação principal">
      <ul class="nav__list">
        {
          mainNav.map((item) =>
            item.children ? (
              <li class="nav__item nav__item--has-children">
                <a
                  href={item.href}
                  class:list={['nav__link', isActive(item.href!) && 'is-active']}
                  aria-haspopup="true"
                >
                  {item.label}
                  <span class="nav__chev" aria-hidden="true">⌄</span>
                </a>
                <ul class="nav__submenu">
                  {item.children.map((c) => (
                    <li>
                      <a href={c.href} class="nav__sublink">
                        {c.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ) : (
              <li class="nav__item">
                <a
                  href={item.href}
                  class:list={['nav__link', isActive(item.href!) && 'is-active']}
                >
                  {item.label}
                </a>
              </li>
            )
          )
        }
      </ul>
    </nav>

    <a href="/agendar" class="header-cta">
      <span>Agende sua consulta</span>
      <span aria-hidden="true">→</span>
    </a>

    <button
      class="nav-toggle"
      aria-label="Abrir menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span></span><span></span><span></span>
    </button>
  </div>

  <!-- Menu mobile -->
  <div class="mobile-menu" id="mobile-menu" hidden>
    <nav class="container" aria-label="Navegação mobile">
      <ul>
        {
          mainNav.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
              {item.children && (
                <ul class="mobile-submenu">
                  {item.children.map((c) => (
                    <li>
                      <a href={c.href}>{c.label}</a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
        <li>
          <a href="/agendar" class="mobile-cta">Agende sua consulta →</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-cream);
    border-bottom: 1px solid var(--color-line);
    transition:
      background-color 0.25s ease,
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }
  .site-header.is-scrolled {
    box-shadow: var(--shadow-card);
  }

  /* Transparente sobre o hero */
  .site-header--transparent {
    position: fixed;
    inset: 0 0 auto 0;
    background: transparent;
    border-bottom-color: transparent;
    color: var(--color-ivory);
  }
  .site-header--transparent .brand__name,
  .site-header--transparent .brand__meta,
  .site-header--transparent .nav__link {
    color: var(--color-ivory);
  }
  .site-header--transparent.is-scrolled {
    position: fixed;
    background: var(--color-espresso);
    border-bottom-color: var(--color-line-dark);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-height: 76px;
  }

  .brand {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    line-height: 1.1;
    margin-right: auto;
  }
  .brand__name {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--color-espresso);
    letter-spacing: -0.01em;
  }
  .brand__meta {
    font-family: 'Jost', sans-serif;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-top: 2px;
  }

  .nav {
    display: none;
  }
  @media (min-width: 1024px) {
    .nav {
      display: block;
    }
  }
  .nav__list {
    display: flex;
    align-items: center;
    gap: 1.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav__item {
    position: relative;
  }
  .nav__link {
    font-family: 'Jost', sans-serif;
    font-size: 0.9rem;
    color: var(--color-espresso);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.4rem 0;
    transition: color 0.15s ease;
  }
  .nav__link:hover,
  .nav__link.is-active {
    color: var(--color-primary);
  }
  .site-header--transparent .nav__link:hover,
  .site-header--transparent .nav__link.is-active {
    color: #fff;
  }
  .nav__chev {
    font-size: 0.7rem;
    opacity: 0.7;
  }

  .nav__submenu {
    position: absolute;
    top: 100%;
    left: -0.75rem;
    min-width: 260px;
    background: var(--surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-soft);
    padding: 0.5rem;
    list-style: none;
    margin: 0.4rem 0 0;
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition: all 0.16s ease;
  }
  .nav__item--has-children:hover .nav__submenu,
  .nav__item--has-children:focus-within .nav__submenu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  .nav__sublink {
    display: block;
    padding: 0.55rem 0.75rem;
    border-radius: var(--radius-sm);
    font-size: 0.9rem;
    color: var(--color-espresso);
    text-decoration: none;
  }
  .nav__sublink:hover {
    background: var(--color-cream);
    color: var(--color-primary);
  }

  .header-cta {
    display: none;
    align-items: center;
    gap: 0.5rem;
    background: var(--color-primary);
    color: var(--color-ivory);
    font-family: 'Jost', sans-serif;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 0.7rem 1.3rem;
    border-radius: var(--radius-pill);
    transition:
      background-color 0.18s ease,
      transform 0.18s ease;
    white-space: nowrap;
  }
  .header-cta:hover {
    background: var(--color-primary-hover);
    color: var(--color-ivory);
    transform: translateY(-1px);
  }
  @media (min-width: 1024px) {
    .header-cta {
      display: inline-flex;
    }
  }

  /* Toggle mobile */
  .nav-toggle {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    padding: 10px;
    background: transparent;
    border: 0;
    cursor: pointer;
    margin-left: auto;
  }
  @media (min-width: 1024px) {
    .nav-toggle {
      display: none;
    }
  }
  .nav-toggle span {
    display: block;
    height: 2px;
    width: 100%;
    background: var(--color-espresso);
    border-radius: 2px;
    transition: all 0.2s ease;
  }
  .site-header--transparent .nav-toggle span {
    background: var(--color-ivory);
  }
  .site-header.is-scrolled.site-header--transparent .nav-toggle span {
    background: var(--color-ivory);
  }
  .nav-toggle[aria-expanded='true'] span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .nav-toggle[aria-expanded='true'] span:nth-child(2) {
    opacity: 0;
  }
  .nav-toggle[aria-expanded='true'] span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .mobile-menu {
    background: var(--color-espresso);
    color: var(--color-ivory);
    border-top: 1px solid var(--color-line-dark);
    padding-block: 1.5rem;
  }
  .mobile-menu ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .mobile-menu > nav > ul > li > a {
    display: block;
    padding: 0.7rem 0;
    color: var(--color-ivory);
    text-decoration: none;
    font-size: 1.05rem;
    border-bottom: 1px solid rgba(241, 232, 218, 0.1);
  }
  .mobile-submenu {
    padding-left: 1rem !important;
    padding-bottom: 0.5rem;
  }
  .mobile-submenu a {
    display: block;
    padding: 0.4rem 0;
    color: var(--color-sand);
    text-decoration: none;
    font-size: 0.95rem;
  }
  .mobile-cta {
    color: var(--color-clay) !important;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-size: 0.9rem !important;
  }
</style>

<script>
  // Header sólido ao rolar
  const header = document.querySelector('.site-header');
  const onScroll = () => {
    if (!header) return;
    header.classList.toggle('is-scrolled', window.scrollY > 20);
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Menu mobile
  const toggle = document.querySelector('.nav-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    toggle.setAttribute('aria-label', open ? 'Abrir menu' : 'Fechar menu');
    if (menu) menu.hidden = open;
  });
</script>
