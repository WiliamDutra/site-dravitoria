---
import '../../styles/global.css';
import Header from './Header.astro';
import Footer from './Footer.astro';
import JsonLd from '../schema/JsonLd.astro';
import { siteGraph } from '../../lib/schema';
import { site } from '../../data/site';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  ogImage?: string;
  ogType?: 'website' | 'article';
  schemaNodes?: object[];
  headerTransparent?: boolean;
  bodyClass?: string;
}

const {
  title,
  description,
  noindex = false,
  ogImage = '/og/og-default.jpg',
  ogType = 'website',
  schemaNodes = [],
  headerTransparent = false,
  bodyClass = '',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const ogImageAbs = new URL(ogImage, Astro.site ?? site.url).href;
const nodes = [...siteGraph(), ...schemaNodes];
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#2B211A" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="pt-BR" href={canonical} />

    {
      noindex ? (
        <meta name="robots" content="noindex, nofollow" />
      ) : (
        <meta name="robots" content="index, follow, max-image-preview:large" />
      )
    }

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.nome} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageAbs} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />

    <!-- Ícones -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- Fontes (design-tokens.md): Cormorant Garamond + Jost -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500;1,600&family=Jost:wght@300;400;500&display=swap"
      rel="stylesheet"
    />

    <!-- JSON-LD (schema médico) -->
    <JsonLd nodes={nodes} />

    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <Header transparent={headerTransparent} />
    <main id="conteudo">
      <slot />
    </main>
    <Footer />
  </body>
</html>
