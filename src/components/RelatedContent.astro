---
interface LinkItem {
  label: string;
  href: string;
  note?: string;
}
interface Props {
  title?: string;
  items: LinkItem[];
  class?: string;
}
const {
  title = 'Conteúdos relacionados',
  items,
  class: className = '',
} = Astro.props;
---

<div class:list={['related', className]}>
  <h2 class="related__title">{title}</h2>
  <ul class="related__list">
    {
      items.map((item) => (
        <li>
          <a href={item.href} class="related__link">
            <span class="related__label">{item.label}</span>
            {item.note && <span class="related__note">{item.note}</span>}
            <span class="related__arrow" aria-hidden="true">
              →
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .related__title {
    font-size: 1.5rem;
    margin-bottom: 1.2rem;
  }
  .related__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }
  @media (min-width: 640px) {
    .related__list {
      grid-template-columns: 1fr 1fr;
    }
  }
  .related__link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 1.1rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-sm);
    text-decoration: none;
    color: var(--color-espresso);
    background: var(--surface);
    transition:
      border-color 0.15s ease,
      transform 0.15s ease;
  }
  .band-dark .related__link,
  .band-mid .related__link {
    background: transparent;
    border-color: var(--color-line-dark);
    color: var(--color-ivory);
  }
  .related__link:hover {
    border-color: var(--color-clay);
    transform: translateX(2px);
  }
  .related__label {
    font-weight: 500;
    font-size: 0.95rem;
  }
  .related__note {
    font-size: 0.8rem;
    color: var(--text-muted);
  }
  .related__arrow {
    margin-left: auto;
    color: var(--color-clay);
  }
</style>
