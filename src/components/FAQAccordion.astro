---
// Sanfona de FAQ (nativa, <details>/<summary>). O conteúdo visível bate 1:1 com o
// schema FAQPage emitido pela página (mesma array). Sem JS obrigatório.
export interface FAQItem {
  q: string;
  a: string;
}
interface Props {
  items: FAQItem[];
  title?: string;
  class?: string;
}
const { items, title, class: className = '' } = Astro.props;
---

<div class:list={['faq', className]}>
  {title && <h2 class="faq__title">{title}</h2>}
  <div class="faq__list">
    {
      items.map((item, i) => (
        <details class="faq__item" name="faq" open={i === 0}>
          <summary class="faq__q">
            <span>{item.q}</span>
            <span class="faq__chev" aria-hidden="true">+</span>
          </summary>
          <div class="faq__a">
            <p>{item.a}</p>
          </div>
        </details>
      ))
    }
  </div>
</div>

<style>
  .faq__title {
    margin-bottom: 1.5rem;
  }
  .faq__list {
    border-top: 1px solid var(--color-line);
  }
  .band-dark .faq__list,
  .band-mid .faq__list {
    border-top-color: var(--color-line-dark);
  }
  .faq__item {
    border-bottom: 1px solid var(--color-line);
  }
  .band-dark .faq__item,
  .band-mid .faq__item {
    border-bottom-color: var(--color-line-dark);
  }
  .faq__q {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    cursor: pointer;
    padding: 1.15rem 0;
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.3;
    list-style: none;
  }
  .faq__q::-webkit-details-marker {
    display: none;
  }
  .faq__chev {
    flex-shrink: 0;
    font-size: 1.4rem;
    line-height: 1;
    color: var(--color-clay);
    transition: transform 0.2s ease;
  }
  details[open] .faq__chev {
    transform: rotate(45deg);
  }
  .faq__a {
    padding: 0 0 1.3rem;
  }
  .faq__a p {
    margin: 0;
    color: var(--text-muted);
    max-width: 68ch;
  }
  .band-dark .faq__a p,
  .band-mid .faq__a p {
    color: var(--color-sand);
  }
</style>
